{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprintjam",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": false
  },
  "main": "./api/index.ts",
  "preview_urls": true,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "sprintjam.co.uk",
      "custom_domain": true,
      "previews_enabled": true
    },
    {
      "pattern": "www.sprintjam.co.uk",
      "zone_name": "sprintjam.co.uk",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "placement": {
    "mode": "smart"
  },
  "services": [
    {
      "binding": "ROOM_WORKER",
      "service": "sprintjam-room-worker"
    },
    {
      "binding": "WHEEL_WORKER",
      "service": "sprintjam-wheel-worker"
    },
    {
      "binding": "AUTH_WORKER",
      "service": "sprintjam-auth-worker"
    },
    {
      "binding": "STATS_WORKER",
      "service": "sprintjam-stats-worker"
    },
    {
      "binding": "STANDUP_WORKER",
      "service": "sprintjam-standup-worker"
    },
    {
      "binding": "RETRO_WORKER",
      "service": "sprintjam-retro-worker"
    }
  ],
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview"
    },
    "services": [
      {
        "binding": "ROOM_WORKER",
        "service": "sprintjam-room-worker"
      },
      {
        "binding": "WHEEL_WORKER",
        "service": "sprintjam-wheel-worker"
      },
      {
        "binding": "AUTH_WORKER",
        "service": "sprintjam-auth-worker"
      },
      {
        "binding": "STATS_WORKER",
        "service": "sprintjam-stats-worker"
      },
      {
        "binding": "STANDUP_WORKER",
        "service": "sprintjam-standup-worker"
      },
      {
        "binding": "RETRO_WORKER",
        "service": "sprintjam-retro-worker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlanningRoom"]
    },
    {
      "tag": "<v2>",
      "deleted_classes": ["PlanningRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "env": {
    "development": {
      "routes": [],
      "vars": {
        "ENVIRONMENT": "development"
      },
      "services": [
        {
          "binding": "ROOM_WORKER",
          "service": "sprintjam-room-worker-development"
        },
        {
          "binding": "AUTH_WORKER",
          "service": "sprintjam-auth-worker-development"
        },
        {
          "binding": "STATS_WORKER",
          "service": "sprintjam-stats-worker-development"
        },
        {
          "binding": "WHEEL_WORKER",
          "service": "sprintjam-wheel-worker-development"
        },
        {
          "binding": "STANDUP_WORKER",
          "service": "sprintjam-standup-worker-development"
        },
        {
          "binding": "RETRO_WORKER",
          "service": "sprintjam-retro-worker-development"
        }
      ],
      "migrations": []
    }
  }
}
