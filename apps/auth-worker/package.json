{
  "name": "@sprintjam/auth-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sprintjam-workspaces-staging --local --persist-to ../../.data --env development",
    "db:migrate:staging": "wrangler d1 migrations apply sprintjam-workspaces-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply sprintjam-workspaces --remote",
    "mfa:reset": "node scripts/reset-user-mfa.mjs",
    "generate:types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@ngriffin_uk/auth-core": "^0.5.1",
    "@ngriffin_uk/auth-encoding": "^0.2.4",
    "@ngriffin_uk/auth-magic-link": "^0.0.6",
    "@ngriffin_uk/auth-otp": "^0.4.4",
    "@ngriffin_uk/auth-protocol": "^0.1.1",
    "@ngriffin_uk/auth-webauthn": "^0.4.6",
    "@sentry/cloudflare": "^10.75.2",
    "@sprintjam/db": "workspace:*",
    "@sprintjam/services": "workspace:*",
    "@sprintjam/types": "workspace:*",
    "@sprintjam/utils": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.136.3"
  }
}
